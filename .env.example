# Copia a .env y completa solo credenciales. No subas .env al repo.
# Una sola cuenta Atlas; el nombre de DB va en la URI (este proyecto).

MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/EnlaceEmpresarial?retryWrites=true&w=majority

# API — puerto dedicado (local; en Vercel no se usa)
PORT=4710
HOST=127.0.0.1

# Auth JWT — genera un secreto local (en Vercel usa otro distinto)
JWT_SECRET=cambia-este-secreto-en-local

UPLOAD_DIR=./uploads
CONFIDENCE_THRESHOLD=0.7

# Web → API (local). En Vercel: dejar PUBLIC_API_URL vacío (mismo origen).
PUBLIC_API_URL=http://127.0.0.1:4710

# Tras configurar MONGODB_URI: pnpm seed
# Demo (solo local): cliente@demo.local / cliente123 · contable@demo.local / contable123

# --- Vercel Services (dashboard; ver DEPLOY-VERCEL.md) ---
# Root del proyecto = raíz del monorepo (vercel.json con "services")
# MONGODB_URI, JWT_SECRET, CONFIDENCE_THRESHOLD
# PUBLIC_API_URL=   (vacío → mismo origen /api)
